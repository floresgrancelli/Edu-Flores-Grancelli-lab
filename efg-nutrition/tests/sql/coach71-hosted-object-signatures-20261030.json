  "snapshot_sql": "select c.relname as tbl,c.relrowsecurity as rls,c.relforcerowsecurity as force_rls,\n(select count(*) from pg_policy p where p.polrelid=c.oid)::int as policies,\n(select md5(string_agg(p.polname::text||p.polcmd::text||p.polpermissive::text||coalesce((select string_agg(case when x.oid=0 then 'PUBLIC' else pg_get_userbyid(x.oid) end,'|' order by case when x.oid=0 then 'PUBLIC' else pg_get_userbyid(x.oid) end) from unnest(p.polroles) as x(oid)),'')||coalesce(pg_get_expr(p.polqual,p.polrelid),'')||coalesce(pg_get_expr(p.polwithcheck,p.polrelid),''),'|@|' order by p.polname::text)) from pg_policy p where p.polrelid=c.oid) as policies_signature,\n(select count(*) from pg_trigger tr where tr.tgrelid=c.oid and not tr.tgisinternal)::int as triggers,\n(select md5(string_agg(pg_get_triggerdef(tr.oid,true),'|@|' order by tr.tgname::text)) from pg_trigger tr where tr.tgrelid=c.oid and not tr.tgisinternal) as triggers_signature,\n(select count(*) from pg_index ix where ix.indrelid=c.oid)::int as indexes,\n(select md5(string_agg(pg_get_indexdef(ix.indexrelid),'|@|' order by ic.relname::text)) from pg_index ix join pg_class ic on ic.oid=ix.indexrelid where ix.indrelid=c.oid) as indexes_signature,\n(select count(*) from pg_constraint co where co.conrelid=c.oid and co.contype='c')::int as checks,\n(select md5(string_agg(co.conname::text||pg_get_constraintdef(co.oid,true),'|@|' order by co.conname::text)) from pg_constraint co where co.conrelid=c.oid and co.contype='c') as checks_signature\nfrom pg_class c join pg_namespace n on n.oid=c.relnamespace where n.nspname='public' and c.relname in ('efg_activities','efg_consents','efg_daily_logs','efg_food_plans','efg_goals','efg_habitual_meals','efg_invitations','efg_messages','efg_notifications','efg_organizations','efg_payments','efg_personal_recipes','efg_profiles','efg_weekly_reports','efg_weights') order by c.relname",
  "access_snapshot_sql": "select c.relname as tbl,(select count(*) from pg_constraint co where co.conrelid=c.oid and co.contype='f')::int as foreign_keys,(select md5(string_agg(co.conname::text||pg_get_constraintdef(co.oid,true),'|@|' order by co.conname::text)) from pg_constraint co where co.conrelid=c.oid and co.contype='f') as foreign_keys_signature,has_table_privilege('anon',c.oid,'SELECT') as anon_select,has_table_privilege('anon',c.oid,'INSERT') as anon_insert,has_table_privilege('anon',c.oid,'UPDATE') as anon_update,has_table_privilege('anon',c.oid,'DELETE') as anon_delete,has_table_privilege('anon',c.oid,'TRUNCATE') as anon_truncate,has_table_privilege('anon',c.oid,'REFERENCES') as anon_references,has_table_privilege('anon',c.oid,'TRIGGER') as anon_trigger,has_table_privilege('authenticated',c.oid,'SELECT') as authenticated_select,has_table_privilege('authenticated',c.oid,'INSERT') as authenticated_insert,has_table_privilege('authenticated',c.oid,'UPDATE') as authenticated_update,has_table_privilege('authenticated',c.oid,'DELETE') as authenticated_delete,has_table_privilege('authenticated',c.oid,'TRUNCATE') as authenticated_truncate,has_table_privilege('authenticated',c.oid,'REFERENCES') as authenticated_references,has_table_privilege('authenticated',c.oid,'TRIGGER') as authenticated_trigger from pg_class c join pg_namespace n on n.oid=c.relnamespace where n.nspname='public' and c.relname in ('efg_activities','efg_consents','efg_daily_logs','efg_food_plans','efg_goals','efg_habitual_meals','efg_invitations','efg_messages','efg_notifications','efg_organizations','efg_payments','efg_personal_recipes','efg_profiles','efg_weekly_reports','efg_weights') order by c.relname",
